# Load necessary libraries
library(dplyr)
library(readr)
library(stringr)
library(tidyr)
# Step 1: Load the CSV files
df1 <- read_csv("C:\\Users\\ju61191\\Desktop\\model_par_conv\\old_pars.csv")
df2 <- read_csv("C:\\Users\\ju61191\\Desktop\\model_par_conv\\new_pars.csv")
key <- read_csv("C:\\Users\\ju61191\\Desktop\\model_par_conv\\key.csv")
# Function to preprocess the data
preprocess <- function(df, key = FALSE) {
# Replace '.' with '_' in the variable columns
if (key) {
df <- df %>%
mutate(across(everything(), ~ str_replace_all(., "\\.", "_")))
} else {
df <- df %>%
mutate(variable = str_replace_all(variable, "\\.", "_"))
}
# Remove all whitespace from the values
df <- df %>%
mutate(across(everything(), ~ str_trim(., side = "both")))
return(df)
}
# Preprocess the dataframes
df1 <- preprocess(df1)
df2 <- preprocess(df2)
key <- preprocess(key, key = TRUE)
# Rename columns for clarity
colnames(key) <- c("old_variable", "new_variable")
# Merge df1 with key to get old and new variable names in df1
df1_merged <- df1 %>%
left_join(key, by = c("variable" = "old_variable"))
df1_merged <- df1_merged %>%
drop_na()
# Merge df2 with key to get new variable names in df2
df2_merged <- df1_merged %>%
left_join(df2, by = c("new_variable" = "variable"))
# Add a column to indicate if the values are different
result_df <- df2_merged %>%
mutate(different_value = ifelse(Value.x != Value.y, TRUE, FALSE))
f_df <- result_df %>%
filter(different_value) %>%
distinct()
View(f_df)
shiny::runApp()
shiny::runApp()
# Define the calcDamage function
calcDamage <- function(score) {
if (score <= 100) {
damage = score * 10
} else if (score > 100 && score <= 200) {
damage = (score - 100) * 30 + 1000
} else {
damage = (score - 200) * 60 + 4000
}
return(damage)
}
# Define the calcResist function
calcResist <- function(def_score) {
return (0.25 * def_score / 100)
}
# Initialize an empty dataframe with the first column named "Base Damage"
results <- data.frame("Base Damage" = numeric())
# Calculate the base damage for each score from 50 to 300 in steps of 5
for (i in seq(50, 300, 5)) {
base_damage <- calcDamage(i)
results <- rbind(results, data.frame("Base Damage" = base_damage))
}
# Add resistance columns to the dataframe
for (j in seq(50, 300, 5)) {
def_val = j
resist_val = calcResist(def_val)
new_vals = as.data.frame(floor(results[,1] - (resist_val*results[,1])))
colnames(new_vals) <- as.character(def_val)
results <- cbind(results, new_vals)
}
# Set row names to the corresponding scores
rownames(results) <- as.character(seq(50, 300, 5))
# Create the new column with row names
results <- cbind(Stat = rownames(results), results)
# Split the dataframe into three parts
results_50_95 <- results[, c("Stat", "Base.Damage", as.character(seq(50, 95, 5)))]
results_100_195 <- results[, c("Stat", "Base.Damage", as.character(seq(100, 195, 5)))]
results_200_300 <- results[, c("Stat", "Base.Damage", as.character(seq(200, 300, 5)))]
# Print the three parts separately
print(results_50_95)
print(results_100_195)
print(results_200_300)
write.csv(results_50_95, "results_50_95.csv", row.names = TRUE)
write.csv(results_100_195, "results_100_195.csv", row.names = TRUE)
write.csv(results_200_300, "results_200_300.csv", row.names = TRUE)
# Multiplier Tables
# Add multiplier columns to the dataframe
# Initialize an empty dataframe with the first column named "Base Damage"
results <- data.frame("Base Damage" = numeric())
# Calculate the base damage for each score from 50 to 300 in steps of 5
for (i in seq(50, 300, 5)) {
base_damage <- calcDamage(i)
results <- rbind(results, data.frame("Base Damage" = base_damage))
}
multipliers <- seq(1.1, 5, 0.1)
for (mult in multipliers) {
new_vals <- as.data.frame(results[, 1] * mult)
colnames(new_vals) <- as.character(mult)
results <- cbind(results, new_vals)
}
# Set row names to the corresponding scores
rownames(results) <- as.character(seq(50, 300, 5))
# Create the new column with row names
results <- cbind(Score = rownames(results), results)
write.csv(results, "results_multiplier.csv", row.names = TRUE)
