library(deSolve)
myModel <- function(t, state, parameters) {
with(as.list(c(state, parameters)), {
dProt <- (-(V_cell*(k_f4*I*Prot)))/V_cell
dA <- (-(V_cell*(k_f1*A*B-k_r1*C_1))+(V_cell*(k_syn5*Prot)))/V_cell
dB <- (-(V_cell*(k_f1*A*B-k_r1*C_1)))/V_cell
dC_1 <- (+(V_cell*(k_f1*A*B-k_r1*C_1))-(V_cell*(kcat_2*Enz*C_1/(Km_2+C_1))))/V_cell
dC_2 <- (+(V_cell*(kcat_2*Enz*C_1/(Km_2+C_1)))-(V_cell*(k_f3*C_2)))/V_cell
dEnz <- 0
dP <- (+(V_cell*(k_f3*C_2)))/V_cell
dI <- (+(V_cell*(k_f3*C_2))-(V_cell*(k_f4*I*Prot)))/V_cell
dI.Prot <- (+(V_cell*(k_f4*I*Prot))-(V_cell*(k_d6*I.Prot)))/V_cell
list(c( dProt,
dA,
dB,
dC_1,
dC_2,
dEnz,
dP,
dI,
dI.Prot ))
})
}
parameters <- c(V_cell = 1,
k_f1 = 2,
k_r1 = 1,
Km_2 = 0.1,
kcat_2 = 3,
k_f3 = 2,
k_f4 = 2,
k_syn5 = 0.5,
k_d6 = 0.1)
state <- c(Prot = 3,
A = 0,
B = 5,
C_1 = 0,
C_2 = 0,
Enz = 0.5,
P = 0,
I = 0,
I.Prot = 0)
times <- seq(0, 15, by = 0.1)
out <- ode(y = state, times = times, func = myModel, parms = parameters)
plot(out)
